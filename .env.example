# Copy to backend/.env and frontend/.env as needed. See each folder's .env.example.

# Postgres (used by backend via Prisma)
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Ethereal Email (leave blank to auto-create a test account on boot)
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_FROM="ReachInbox Scheduler <scheduler@reachinbox.local>"

# Slack notifications (Incoming Webhook URL, optional)
SLACK_WEBHOOK_URL=

# Elasticsearch (optional — app falls back to Postgres if unreachable)
ELASTICSEARCH_URL=http://localhost:9200

# Worker tuning
WORKER_CONCURRENCY=5
EMAIL_RATE_MAX=10
EMAIL_RATE_DURATION_MS=60000

# Backend
PORT=3001
